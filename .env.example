# Copy to .env. .env is git-ignored; never commit secrets.

# ---- Host ports (change only if another app already uses them)
WEB_DEV_PORT=5173
WEB_PROD_PORT=8080

# ---- Server (validated at startup, see server/src/config/env.ts)
# Required. SQLite file inside the db-data volume; created on first start.
DATABASE_PATH=/data/app.db
# Optional, defaults shown
PORT=3000
NODE_ENV=production
LOG_LEVEL=info
# Comma-separated origins allowed for CORS; empty = same origin only
CORS_ORIGINS=
BODY_LIMIT_BYTES=102400
READY_DB_TIMEOUT_MS=2000
SHUTDOWN_GRACE_MS=10000
